Options -Indexes
DirectoryIndex index.html

# Force HTTPS and www in one redirect.
# Loop guard: skip when the request is already HTTPS, either directly (%{HTTPS})
# or behind a TLS-terminating proxy (X-Forwarded-Proto). /.well-known/ stays
# reachable over plain HTTP for SSL certificate (AutoSSL) validation.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.atmarbio.com%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^atmarbio\.com$ [NC]
RewriteRule ^ https://www.atmarbio.com%{REQUEST_URI} [R=301,L]

# Block files that are in the repository but are not part of the website.
# The server deploys with git pull, so everything in the repo lands in the web root.
# 1) Hidden files and folders: .git, .htaccess, .DS_Store, .gitignore ...
#    (/.well-known/ stays reachable for SSL certificate validation)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
# 2) Email campaign sources and other non-site folders
RewriteRule ^(petfood-email-campaign|sweetflavour-email-campaign)(/|$) - [F,L]
RewriteRule ^sweet\sflavour\smail\scampaign$ - [F,L]
# 3) Documents, notes and scripts that are never linked from the site
<FilesMatch "\.(docx?|xlsx?|md|txt|py|mjs|sh|log|bak|zip)$">
    Require all denied
</FilesMatch>
<FilesMatch "^robots\.txt$">
    Require all granted
</FilesMatch>

# Custom error pages
ErrorDocument 404 /404.html

# Correct MIME types
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
