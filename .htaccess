Options -Indexes
DirectoryIndex index.html

# Force HTTPS and www in one redirect.
# Loop guard: skip when the request is already HTTPS, either directly (%{HTTPS})
# or behind a TLS-terminating proxy (X-Forwarded-Proto). /.well-known/ stays
# reachable over plain HTTP for SSL certificate (AutoSSL) validation.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.atmarbio.com%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^atmarbio\.com$ [NC]
RewriteRule ^ https://www.atmarbio.com%{REQUEST_URI} [R=301,L]

# Custom error pages
ErrorDocument 404 /404.html

# Correct MIME types
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
